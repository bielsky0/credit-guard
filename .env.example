# --- Postgres (superuser, used only by the init script) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
# NOTE: not 5432 — avoids colliding with a Postgres already running on the host/other projects.
POSTGRES_PORT=5433

# --- Postgres: one database + role per service (database-per-service, §3/§6) ---
APPLICANT_DB_NAME=applicant_db
APPLICANT_DB_USER=applicant_svc
APPLICANT_DB_PASSWORD=applicant_dev_pw

LOAN_DB_NAME=loan_db
LOAN_DB_USER=loan_svc
LOAN_DB_PASSWORD=loan_dev_pw

DOCUMENT_DB_NAME=document_db
DOCUMENT_DB_USER=document_svc
DOCUMENT_DB_PASSWORD=document_dev_pw

UNDERWRITING_DB_NAME=underwriting_db
UNDERWRITING_DB_USER=underwriting_svc
UNDERWRITING_DB_PASSWORD=underwriting_dev_pw

DISBURSEMENT_DB_NAME=disbursement_db
DISBURSEMENT_DB_USER=disbursement_svc
DISBURSEMENT_DB_PASSWORD=disbursement_dev_pw

# --- Redis ---
# NOTE: not 6379 — avoids colliding with a Redis already running on the host/other projects.
REDIS_PORT=6380

# --- Kafka (KRaft, single broker) ---
KAFKA_INTERNAL_PORT=9092
KAFKA_HOST_PORT=9094
KAFKA_CONTROLLER_PORT=9093
# Fixed cluster ID for local dev (any valid base64 16-byte UUID works; generated once with `kafka-storage.sh random-uuid`)
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qg

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_pw
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Jaeger ---
JAEGER_UI_PORT=16686
# NOTE: not 4317/4318 — avoids colliding with another OTLP collector already running on the host.
JAEGER_OTLP_GRPC_PORT=4319
JAEGER_OTLP_HTTP_PORT=4320
