# API Gateway Environment Variables
# Copy to .env and adjust as needed

# Gateway listens on this port
GATEWAY_PORT=8000

# JWT public key (generated by keygen.py in applicant service, shared via volume)
JWT_PUBLIC_KEY_PATH=/app/keys/public_key.pem

# Internal service base URLs (Docker network — no external access)
APPLICANT_SERVICE_URL=http://applicant:8001
LOAN_SERVICE_URL=http://loan-application:8002
DOCUMENT_SERVICE_URL=http://document:8003

# Redis (rate limiting + pub/sub)
REDIS_URL=redis://localhost:6380/0

# Rate limiting config
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_LOANS_PER_10_MIN=3
